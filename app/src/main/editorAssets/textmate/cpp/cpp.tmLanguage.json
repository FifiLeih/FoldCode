{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FoldCode C/C++",
  "scopeName": "source.cpp",
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.cpp", "match": "//.*$" },
        { "name": "comment.block.cpp", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.cpp",
          "begin": "^\\s*(#)\\s*(include|define|undef|if|ifdef|ifndef|elif|else|endif|error|warning|pragma|line)\\b",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.directive.cpp" },
            "2": { "name": "keyword.control.directive.cpp" }
          },
          "end": "(?<!\\\\)$",
          "patterns": [
            { "name": "string.quoted.other.lt-gt.include.cpp", "match": "<[^>]+>" },
            { "include": "#strings" },
            { "include": "#comments" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cpp",
          "begin": "(?:u8|u|U|L)?\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.cpp", "match": "\\\\(?:[abefnrtv\\\\'\"?]|x[0-9A-Fa-f]+|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|[0-7]{1,3})" }]
        },
        {
          "name": "string.quoted.single.cpp",
          "begin": "(?:u8|u|U|L)?'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.cpp", "match": "\\\\." }]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.cpp", "match": "\\b0[xX][0-9A-Fa-f](?:'?[0-9A-Fa-f])*[uUlL]*\\b" },
        { "name": "constant.numeric.binary.cpp", "match": "\\b0[bB][01](?:'?[01])*[uUlL]*\\b" },
        { "name": "constant.numeric.float.cpp", "match": "\\b(?:[0-9](?:'?[0-9])*)?\\.[0-9](?:'?[0-9])*(?:[eE][+-]?[0-9]+)?[fFlL]?\\b" },
        { "name": "constant.numeric.decimal.cpp", "match": "\\b[0-9](?:'?[0-9])*[uUlL]*\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.cpp", "match": "\\b(?:break|case|catch|co_await|co_return|co_yield|continue|default|do|else|for|goto|if|return|switch|throw|try|while)\\b" },
        { "name": "storage.modifier.cpp", "match": "\\b(?:alignas|const|consteval|constexpr|constinit|explicit|extern|friend|inline|mutable|register|static|thread_local|typedef|volatile)\\b" },
        { "name": "storage.type.cpp", "match": "\\b(?:auto|bool|char|char8_t|char16_t|char32_t|class|concept|double|enum|float|int|long|namespace|short|signed|struct|template|typename|union|unsigned|using|void|wchar_t)\\b" },
        { "name": "keyword.operator.cpp", "match": "\\b(?:alignof|and|and_eq|asm|bitand|bitor|compl|decltype|delete|dynamic_cast|new|noexcept|not|not_eq|operator|or|or_eq|reinterpret_cast|requires|sizeof|static_assert|static_cast|typeid|xor|xor_eq)\\b" },
        { "name": "variable.language.this.cpp", "match": "\\bthis\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.std.cpp", "match": "\\b(?:std|size_t|ssize_t|int8_t|int16_t|int32_t|int64_t|uint8_t|uint16_t|uint32_t|uint64_t|string|string_view|vector|array|map|unordered_map|unique_ptr|shared_ptr|optional|variant|tuple)\\b" },
        { "name": "entity.name.type.cpp", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.cpp", "match": "\\b(?:true|false|nullptr|NULL)\\b" },
        { "name": "constant.other.macro.cpp", "match": "\\b[A-Z][A-Z0-9_]{2,}\\b" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "entity.name.function.call.cpp", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()" },
        { "name": "punctuation.accessor.cpp", "match": "::|->|\\." }
      ]
    }
  }
}
